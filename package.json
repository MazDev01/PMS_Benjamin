{
  "name": "benjamin-pms",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:hq": "turbo dev --filter=hq",
    "dev:dealer": "turbo dev --filter=dealer",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tests/tsconfig.json --noEmit",
    "lint": "turbo lint",
    "test": "playwright test",
    "test:api": "node scripts/test-api.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test:prodbuild": "node scripts/test-prodbuild.mjs",
    "test:mobile": "playwright test -c playwright.mobile.config.ts",
    "test:unit": "vitest run",
    "audit:api": "node scripts/api-audit.mjs",
    "audit:db": "node scripts/db-audit.mjs && node scripts/db-audit2.mjs && node scripts/db-audit3.mjs",
    "audit:race": "node scripts/race-audit.mjs",
    "audit:storage": "node scripts/storage-audit.mjs",
    "audit:admin": "node scripts/admin-audit.mjs",
    "seed:volume": "node scripts/seed-volume.mjs",
    "audit:perf": "node scripts/perf-audit.mjs && node scripts/perf-ui2.mjs",
    "audit:logic": "node scripts/logic-audit.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "load-test": "node scripts/load-test.mjs",
    "backup": "node scripts/backup.mjs",
    "db:push:prod": "node scripts/db-push-prod.mjs",
    "restore": "node scripts/restore.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "checks": "node scripts/check-stable-order.mjs && node scripts/check-form-labels.mjs && node scripts/check-unchecked-mutations.mjs && node scripts/check-paginated-lookup.mjs && node scripts/check-network-list-keys.mjs && node scripts/check-filter-resets-page.mjs && node scripts/check-table-scroll-shadow.mjs && node scripts/check-real-backend.mjs && node scripts/check-dealer-code-fallback.mjs && node scripts/check-select-unspecified.mjs && node scripts/check-password-no-space.mjs && node scripts/check-export-import-columns.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/supabase-js": "^2.110.7",
    "supabase": "^2.109.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
