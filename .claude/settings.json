{
  "permissions": {
    "allow": [
      "PowerShell(npm run dev)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-cli.mjs\""
          }
        ]
      }
    ]
  }
}
