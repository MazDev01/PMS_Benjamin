{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // ── ให้สั่งสลับ "โหมดข้อมูล" จากบรรทัดคำสั่งได้ (npm run dev:api) ──────────────
      // turbo 2 กรอง env ทิ้งทุกตัวที่ไม่ประกาศไว้ (envMode ค่าตั้งต้น = strict)
      // ไม่ประกาศ = สั่ง NEXT_PUBLIC_DATA_SOURCE=api แล้วเซิร์ฟเวอร์ยังอ่านค่าจาก .env.local เหมือนเดิม
      // → เทสต์ที่ตั้งใจวัดโหมด api จะวัดโหมด supabase แทน โดยไม่มีอะไรเตือน
      "passThroughEnv": ["NEXT_PUBLIC_DATA_SOURCE"]
    },
    // ไม่แคช (21 ต.ค. 69): แอป dealer/hq ตรวจชนิดโค้ดของ packages/shared ด้วย แต่กุญแจแคชของแอปไม่รวมไฟล์ของ shared
    //   แก้ mock.ts แล้ว typecheck ตอบ "cache hit" ผ่าน ทั้งที่หน้าใบเสนอราคาของ dealer ตรวจไม่ผ่านจริง — ขั้นแรกของรอบปิดด่านพลาดได้
    "typecheck": { "cache": false },
    "lint": {}
  }
}
